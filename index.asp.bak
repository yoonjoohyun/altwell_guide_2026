    </div>

    <div id="ctrl">
      <div id="tl" onclick="onSeek(event)">
        <div id="tlf"></div>
        <div id="tlt"></div>
      </div>
      <div id="cr">
        <button class="cb" id="btn-p" onclick="togglePlay()">&#9654;</button>
        <button class="cb" onclick="doRestart()" title="처음부터">&#8635;</button>
        <span id="tdsp">0:00 / 3:00</span>
        <span id="slbl">장면 1 &middot; 시작</span>
      </div>
